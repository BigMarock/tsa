pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
function _init()
	pal({[0]=0,1,140,12,2,136,8,128,133,5,134,6,7,9,10,14},1)
	--poke(0x5f2e, 1)
	
	plr = {
		x = 56,
		y = 56,
		vx = 0,
		vy = 0,
		s = 1,
		speed = 1.5
	}
	
	game = {
		bg = 0,
		screenx = 0,
		screeny = 0
	}
end

function _update()
	plrupdate()
end

function _draw()
	cls(game.bg)
	map(flr(game.screenx/128), flr(game.screeny/128))
	spr(plr.s, plr.x, plr.y)
end
-->8
-- player --

function pointsoliddetect(x, y)
	return fget(mget(x/8, y/8), 0)
end

function plrsoliddetect(tl, tr, bl, br)
	local x = plr.x
	local y = plr.y
	local ftl = pointsoliddetect(x, y) and tl
	local ftr = pointsoliddetect(x + 7, y) and tr
	local fbl = pointsoliddetect(x, y + 7) and bl
	local fbr = pointsoliddetect(x + 7, y + 7) and br 
	
	return ftl or ftr or fbl or fbr
end

function plrupdate()
	local lx = flr(plr.x)
	local ly = flr(plr.y)
	
	plr.x += plr.vx
	plr.y += plr.vy
	
	plr.vx *= 0.6
	plr.vy *= 0.6
	
	if btn(➡️) then
		plr.s = 1
		plr.vx += 1
	end
	if btn(⬇️) then
		plr.s = 4
		plr.vy += 1
	end
	if btn(⬅️) then
		plr.s = 3
		plr.vx -= 1
	end
	if btn(⬆️) then
		plr.s = 2
		plr.vy -= 1
	end
	
	if plrsoliddetect(true, true, true, true) then
		plr.x = lx
		plr.y = ly
	end
end
