pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
function _init()
	pal({[0]=0,1,140,12,2,136,8,128,133,5,134,6,7,9,10,14},1)
	--poke(0x5f2e, 1)
	
	npcs = {}
	
	plr = {
		x = 56,
		y = 56,
		w = 8,
		h = 8,
		vx = 0,
		vy = 0,
		f = 0.6,
		s = 1,
		terminal = 10,
		speed = 1,
		scraps = 0,
	}
	
	game = {
		bg = 0,
		screenx = 0,
		screeny = 0,
		screenanim = false,
		pause = false,
		targetscreen = {0, 0}
	}
end

function _update()
	if not game.pause then
		plrupdate()
		npcupdate()
	else
		if targetscreen != {game.screenx, game.screeny} then
			local tdx = game.targetscreen[1]
			local tdy = game.targetscreen[2]
			
			local xdir = 1
			local ydir = 1
			if tdx < game.screenx then
				xdir = -1
			elseif game.screenx == tdx then
				xdir = 0
			end
			if tdy < game.screeny then
				ydir = -1
			elseif game.screeny == tdy then
				ydir = 0
			end

			local xdiff = xdir * min(4, abs(tdx - game.screenx))
			local ydiff = ydir * min(4, abs(tdy - game.screeny))
			
			game.pause = tdx != game.screenx or tdy != game.screeny
			if game.pause then
				game.screenx += xdiff
				game.screeny += ydiff
			end
		end
	end
end

function _draw()
	cls(game.bg)
	
	local mxcell = flr(game.screenx/8)
	local mycell = flr(game.screeny/8)
	
	map(mxcell, mycell, mxcell * 8 - game.screenx, mycell * 8 - game.screeny)
	spr(plr.s, plr.x - game.screenx, plr.y - game.screeny)
	npcdraw()
	
	print(abs(plr.vx) + abs(plr.vy))
end
-->8
-- player --

function pointsoliddetect(x, y, f)
	return fget(mget(x/8, y/8), f)
end

function plrsoliddetect(f)
	local x = plr.x
	local y = plr.y
	local ftl = pointsoliddetect(x, y, f)
	local ftr = pointsoliddetect(x + plr.w - 1, y, f)
	local fbl = pointsoliddetect(x, y + plr.h - 1, f)
	local fbr = pointsoliddetect(x + plr.w - 1, y + plr.h - 1, f)
	
	return ftl or ftr or fbl or fbr
end

function plrxbounds()
	local l = plr.x + plr.w - 1 - game.screenx < 0 or plr.x + plr.w - 1 - game.screenx > 127
	local r = plr.x - game.screenx < 0 or plr.x - game.screenx > 127
	return l and r
end

function plrybounds()
	local l = plr.y + plr.h - 1 - game.screeny < 0 or plr.y + plr.h - 1 - game.screeny > 127
	local r = plr.y - game.screeny < 0 or plr.y - game.screeny > 127
	return l and r
end

function plrmapbounds()
	local maxyrange = 128
	local maxxrange = 256
	return plr.x < 0 or plr.y < 0 or plr.x > maxxrange or plr.y > maxyrange
end

function round(n)
	local b = n - flr(n)
	if b > 0.5 then
		return ceil(n)
	else
		return flr(n)
	end
end

function plrupdate()
	local lx = flr(plr.x)
	local ly = flr(plr.y)
	
	plr.x = round(plr.x + plr.vx)
	plr.y = round(plr.y + plr.vy)
	
	if plrsoliddetect(0) or plrmapbounds() then
		plr.x = lx
		plr.y = ly
	end
	
	if plrsoliddetect(1) then
		plr.vx *= -5
		plr.vy *= -5
	end
	
	plr.vx = min(plr.terminal, plr.vx * plr.f)
	plr.vy = min(plr.terminal, plr.vy * plr.f)
	
	local b = {btn(➡️), btn(⬇️), btn(⬅️), btn(⬆️)}
	local fxc = false
	
	if b[1] then
		plr.s = 1
		plr.vx += plr.speed
		fxc = true
	end
	if b[2] then
		plr.s = 4
		plr.vy += plr.speed
		fxc = true
	end
	if b[3] then
		plr.s = 3
		plr.vx -= plr.speed
		fxc = true
	end
	if b[4] then
		plr.s = 2
		plr.vy -= plr.speed
		fxc = true
	end
	
	if b[1] and b[2] then
		plr.s = 8
	end
	if b[2] and b[3] then
		plr.s = 7
	end
	if b[3] and b[4] then
		plr.s = 5
	end
	if b[4] and b[1] then
		plr.s = 6
	end
	
	if fxc and rnd(1) > 0.5 and (plr.x % 10 == 0 or plr.y % 10 == 0) then
		addnpc(0, plr.x, plr.y, 24)
	end
	
	if not game.pause then
		if plrxbounds() then
			if plr.x - game.screenx > 64 then
				game.targetscreen[1] = game.screenx + 128
			else
				game.targetscreen[1] = game.screenx - 128
			end
			game.pause = true
		end
		if plrybounds() then
			if plr.y - game.screeny > 64 then
				game.targetscreen[2] = game.screeny + 128
			else
				game.targetscreen[2] = game.screeny - 128
			end
			game.pause = true
		end
	end
end
-->8
-- projectiles / sprites --

function addnpc(id, x, y, data)
	if #npcs > 9 then
		return
	end

	local s = 1
	if id == 0 then
		s = 9
	end
	
	local npc = {
		id = id,
		s = s,
		x = x,
		y = y,
		d = data
	}
	add(npcs, npc)
end

function npcdraw()
	for i, npc in pairs(npcs) do
		spr(npc.s, npc.x - game.screenx, npc.y - game.screeny)
	end
end

function npcupdate()
	for i, npc in pairs(npcs) do
		if npc.id == 0 then
			npc.s = 12 - flr(npc.d / 6)
			npc.d -= 1
		end
		if type(npc.d) == 'number' then
			if npc.d < 0 then
				del(npcs, npc)
			end
		end
	end
end
