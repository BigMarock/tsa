pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
function _update()
	plrupdate()
	
	for i2, i in pairs(fxdel) do
		del(fx, i)
		del(fxdel, i2)
	end
end

function _draw()
	cls(7)
	
	for i, p in pairs(fx) do
		if p.life < 0 then
			add(fxdel, i)
		else
			p.life -= 1
		
			if p.id == 0 then
				spr(31 + ceil((16 - p.life) / 4), p.x, p.y)
			end
		end
	end
	
	rectfill(plr.x-2, plr.y-2, plr.x+plr.w+1, plr.y+plr.h+1, 1)
	sspr(plr.sprite*8, 0, plr.sprite*8+8,16, plr.x, plr.y, plr.w, plr.h)
end
-->8
-- player --
plr = {
	x=64,
	y=64,
	vx=0,
	vy=0,
	w=16,
	h=16,
	sprite=1,
	controls=true,
}

function plrupdate()
	plr.x += plr.vx
	plr.vx *= 0.9
	
	plr.y -= plr.vy
	plr.vy -= 0.4
	
	plr.w = 16 + abs(plr.vx) - plr.vy * 0.2
	plr.h = 16 + plr.vy
	
	if plr.x < 2 then
		plr.x = 2
		plr.vx = 0
	end
	
	if plr.y < 2 then
		plr.y = 2
		plr.vy = 0
	end
	
	local f = 133 - plr.w
	if plr.x > f then
		plr.x = f
		plr.vx = 0
	end
	
	if plr.y > 133 - plr.h then
		if plr.controls == true then
			plr.controls = false
			plr.y = 128
			plr.vy = 5
			plr.sprite = 3
		elseif plr.y > 128 then
			plrreset()
		end
	end

	if plr.controls then
		if btn(➡️) then
			plr.vx += 0.5
		end
		if btn(⬅️) then
			plr.vx -= 0.5
		end
		
		if btn(⬆️) then
			if plr.vy < 3 then
				plr.vy += 2
			end
			
			if rnd(1) < 0.2 then
				addparticle(0, plr.x, plr.y + plr.h)
			end
		end
	end
end

function plrreset()
	plr.controls = true
	plr.x = 64
	plr.y = 64
	plr.vy = 0
	plr.vx = 0
	plr.sprite = 1
end
-->8
-- fx --

fx = {}
fxdel = {}

function addparticle(id, x, y)
	life = 0
	
	if id == 0 then
		life = 16
	end
	
	local p = {
		['id'] = id,
		['x'] = x,
		['y'] = y,
		['life'] = life
	}
	
	add(fx, p)
end
